<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadIdentifier</key>
    <string>com.nhstores.wifi</string>

    <key>PayloadUUID</key>
    <string>11111111-2222-3333-4444-555555555555</string>

    <key>PayloadDisplayName</key>
    <string>NHstores WiFi</string>

    <key>PayloadOrganization</key>
    <string>NHstores</string>

    <key>PayloadDescription</key>
    <string>Wi-Fi configuration for NHstores</string>

    <key>PayloadContent</key>
    <array>

        <dict>

            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>PayloadIdentifier</key>
            <string>com.nhstores.wifi.payload</string>

            <key>PayloadUUID</key>
            <string>66666666-7777-8888-9999-AAAAAAAAAAAA</string>

            <key>PayloadDisplayName</key>
            <string>NHstores</string>

            <!-- SSID -->
            <key>SSID_STR</key>
            <string>NHstores</string>

            <!-- Auto Join -->
            <key>AutoJoin</key>
            <true/>

            <!-- Hidden SSID -->
            <key>HIDDEN_NETWORK</key>
            <false/>

            <!-- WPA/WPA2 Enterprise -->
            <key>EncryptionType</key>
            <string>WPA</string>

            <key>EAPClientConfiguration</key>
            <dict>

                <!-- EAP-TTLS -->
                <key>AcceptEAPTypes</key>
                <array>
                    <integer>21</integer>
                </array>

                <!-- Anonymous identity -->
                <key>OuterIdentity</key>
                <string>anonymous</string>

                <!-- Inner authentication -->
                <key>TTLSInnerAuthentication</key>
                <string>PAP</string>

                <!-- Server validation -->
                <key>TLSTrustedServerNames</key>
                <array>
                    <string>eap.meraki.com</string>
                </array>

            </dict>

        </dict>

    </array>

</dict>
</plist>